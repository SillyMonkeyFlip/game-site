diff --git a/source/states/stages/Forest.hx b/source/states/stages/Forest.hx
new file mode 100644
index 0000000..7c883f7
--- /dev/null
+++ b/source/states/stages/Forest.hx
@@ -0,0 +1,735 @@
+package states.stages;
+
+import flixel.FlxBasic;
+import flixel.FlxObject;
+import flixel.text.FlxText;
+import flixel.text.FlxText.FlxTextBorderStyle;
+import flixel.tweens.FlxEase.EaseFunction;
+import objects.Note;
+import psychlua.ModchartSprite;
+
+/**
+ * "Nocturnal Protocol (Fan Recreation)" — hardcoded web port.
+ *
+ * The browser build can't run Lua, so every script from the mod is translated
+ * here 1:1, keeping the same callback order Psych uses for Lua scripts:
+ *   scripts/letterbox.lua, scripts/icons.lua  (global scripts)
+ *   stages/Forest.lua                         (stage script)
+ *   custom_notetypes/CustardNote.lua          (note type)
+ *   custom_events/*.lua                       (events)
+ */
+class Forest extends BaseStage
+{
+	var ps(get, never):PlayState;
+	inline function get_ps():PlayState return PlayState.instance;
+
+	// ---------------------------------------------------------------------
+	// Tiny stand-in for the Lua sprite/tween/timer API
+	// ---------------------------------------------------------------------
+	var sprites:Map<String, FlxSprite> = [];
+	var tweens:Map<String, FlxTween> = [];
+	var timers:Map<String, FlxTimer> = [];
+
+	function makeSprite(tag:String, image:String, x:Float, y:Float):ModchartSprite
+	{
+		removeSprite(tag);
+		var spr = new ModchartSprite(x, y);
+		if (image != null && image.length > 0) spr.loadGraphic(Paths.image(image));
+		spr.active = true;
+		sprites.set(tag, spr);
+		return spr;
+	}
+
+	function makeAnimatedSprite(tag:String, image:String, x:Float, y:Float):ModchartSprite
+	{
+		removeSprite(tag);
+		var spr = new ModchartSprite(x, y);
+		spr.frames = Paths.getSparrowAtlas(image);
+		sprites.set(tag, spr);
+		return spr;
+	}
+
+	function addAnimByPrefix(spr:ModchartSprite, name:String, prefix:String, fps:Float, loop:Bool)
+	{
+		spr.animation.addByPrefix(name, prefix, fps, loop);
+		if (spr.animation.curAnim == null) spr.playAnim(name, true);
+	}
+
+	function scaleObject(spr:FlxSprite, sx:Float, sy:Float)
+	{
+		if (spr == null) return;
+		spr.scale.set(sx, sy);
+		spr.updateHitbox();
+	}
+
+	function setCamera(obj:FlxBasic, cam:String)
+	{
+		obj.cameras = [switch (cam) { case 'hud': camHUD; case 'other': camOther; default: camGame; }];
+	}
+
+	function addSprite(tag:String, front:Bool)
+	{
+		var spr = sprites.get(tag);
+		if (spr == null) return;
+		if (front) ps.add(spr);
+		else
+		{
+			var low:Int = ps.members.indexOf(ps.boyfriendGroup);
+			for (g in [ps.dadGroup, ps.gfGroup])
+			{
+				var i = ps.members.indexOf(g);
+				if (i >= 0 && i < low) low = i;
+			}
+			ps.insert(low, spr);
+		}
+	}
+
+	function removeSprite(tag:String)
+	{
+		var spr = sprites.get(tag);
+		if (spr == null) return;
+		ps.remove(spr, true);
+		sprites.remove(tag);
+		spr.destroy();
+	}
+
+	inline function spr(tag:String):FlxSprite return sprites.get(tag);
+
+	function tween(tag:String, target:Dynamic, values:Dynamic, duration:Float, ease:EaseFunction)
+	{
+		if (target == null) return;
+		var old = tweens.get(tag);
+		if (old != null) { old.cancel(); old.destroy(); }
+		tweens.set(tag, FlxTween.tween(target, values, duration, {ease: ease, onComplete: function(_) {
+			tweens.remove(tag);
+			onTweenCompleted(tag);
+		}}));
+	}
+
+	function runTimer(tag:String, time:Float)
+	{
+		cancelTimer(tag);
+		timers.set(tag, new FlxTimer().start(time, function(_) {
+			timers.remove(tag);
+			onTimerCompleted(tag);
+		}));
+	}
+
+	function cancelTimer(tag:String)
+	{
+		var t = timers.get(tag);
+		if (t != null) { t.cancel(); t.destroy(); timers.remove(tag); }
+	}
+
+	// ---------------------------------------------------------------------
