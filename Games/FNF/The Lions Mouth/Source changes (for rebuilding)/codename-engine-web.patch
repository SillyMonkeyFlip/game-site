+package funkin.backend.web;
+
+/** Web stand-in for sys.io.File, backed by the preloaded asset manifest. */
+class WebFile {
+	public static function getContent(path:String):String {
+		if (!WebFS.isFile(path)) return null;
+		var id = WebFS.clean(path);
+		var t = WebFS.raw.getText(id);
+		return t;
+	}
+	public static function getBytes(path:String):haxe.io.Bytes {
+		if (!WebFS.isFile(path)) return null;
+		return WebFS.raw.getBytes(WebFS.clean(path));
+	}
+	public static function saveContent(path:String, content:String):Void {}
+	public static function saveBytes(path:String, bytes:haxe.io.Bytes):Void {}
+	public static function copy(src:String, dst:String):Void {}
+	public static function append(path:String, ?binary:Bool):Dynamic return null;
+	public static function write(path:String, ?binary:Bool):Dynamic return null;
+	public static function read(path:String, ?binary:Bool):Dynamic return null;
+}
