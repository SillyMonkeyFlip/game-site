+	// ---------------------------------------------------------------------
+	// onCreatePost
+	// ---------------------------------------------------------------------
+	override function createPost()
+	{
+		// letterbox.lua
+		for (i in 0...4)
+		{
+			var p = ps.playerStrums.members[i];
+			if (p != null) p.x += playerOffsetX;
+			var o = ps.opponentStrums.members[i];
+			if (o != null) o.x += opponentOffsetX;
+		}
+
+		// Forest.lua
+		for (o in ps.opponentStrums.members) if (o != null) o.visible = false;
+		ps.scoreTxt.visible = false;
+		game.timeTxt.visible = false;
+		ps.iconP2.alpha = 0;
+		dad.alpha = 0;
+		boyfriend.alpha = 0;
+		boyfriend.scale.set(1, 1);
+
+		// CustardNote.lua
+		for (note in unspawnNotes)
+		{
+			if (note.noteType == 'CustardNote')
+			{
+				note.texture = 'custard';
+				note.isSustainNote = false;
+				note.scale.set(0.7, 0.7);
+				note.noAnimation = true;
+			}
+		}
+	}
+
+	// letterbox.lua onSpawnNote
+	override function scriptSpawnNote(note:Note)
+	{
+		note.x += note.mustPress ? playerOffsetX : opponentOffsetX;
+	}
+
+	// ---------------------------------------------------------------------
+	// onSongStart
+	// ---------------------------------------------------------------------
+	override function startSong()
+	{
+		var text = makeSprite('text', 'dayforest/text', 610, 10);
+		text.scrollFactor.set(1, 1);
+		scaleObject(text, 0.6, 0.6);
+		setCamera(text, 'other');
+		addSprite('text', true);
