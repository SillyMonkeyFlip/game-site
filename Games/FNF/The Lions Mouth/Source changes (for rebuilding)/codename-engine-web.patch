diff --git a/source/funkin/backend/web/JsPolyfills.hx b/source/funkin/backend/web/JsPolyfills.hx
new file mode 100644
index 00000000..c31ebfa2
--- /dev/null
+++ b/source/funkin/backend/web/JsPolyfills.hx
@@ -0,0 +1,27 @@
+package funkin.backend.web;
+
+/**
+ * On JS, a few Haxe Array methods are compiled to static helpers instead of real methods,
+ * so a script calling `array.remove(x)` through reflection finds nothing. Add them to the prototype.
+ */
+class JsPolyfills {
+	static var done = false;
+	public static function init() {
+		if (done) return;
+		done = true;
+		// keep these classes alive for the polyfills below
+		var _a:Dynamic = haxe.iterators.ArrayIterator; var _b:Dynamic = haxe.iterators.ArrayKeyValueIterator;
+		js.Syntax.code("
+		(function(P){
+			function def(n, f){ if (!Object.prototype.hasOwnProperty.call(P, n)) Object.defineProperty(P, n, {value: f, writable: true, configurable: true, enumerable: false}); }
+			def('remove', function(x){ var i = this.indexOf(x); if (i == -1) return false; this.splice(i, 1); return true; });
+			def('contains', function(x){ return this.indexOf(x) != -1; });
+			def('insert', function(pos, x){ this.splice(pos, 0, x); });
+			def('copy', function(){ return this.slice(); });
+			def('resize', function(len){ if (this.length > len) this.length = len; else { this.length = len; } });
+			def('iterator', function(){ return new haxe_iterators_ArrayIterator(this); });
+			def('keyValueIterator', function(){ return new haxe_iterators_ArrayKeyValueIterator(this); });
+		})(Array.prototype);
+		");
+	}
+}
