+	var appeared = false;
+	var tinkyScale:Float = 1;
+	var tinkyScale2:Float = 1;
+	static inline var tinkyX:Float = 800;
+	static inline var tinkyY:Float = 1100;
+	static inline var tinkyStartScale:Float = 1.2;
+	static inline var custardGrowTime:Float = 18;
+	static inline var custardMaxScale:Float = 2.3;
+	var custardGrowing = false;
+	static inline var custardScale:Float = 0.3;
+	static inline var custardX:Float = 990;
+	static inline var custardY:Float = 1200;
+
+	// CustardNote.lua
+	var custardCount:Int = 0;
+	var custardText:FlxText;
+
+	// CamSwing.lua
+	var camSwing = false;
+	var swingTime:Float = 1;
+	static inline var swingSpeed:Float = 0.8;
+	static inline var swingAmount:Float = 1;
+
+	// CharSwing.lua
+	var charSwing = false;
+	var swingProgress:Float = 1;
+	var swingDuration:Float = 0;
+	var swingStart:Float = 5;
+	var swingTarget:Float = -5;
+
+	// Screamers.lua
