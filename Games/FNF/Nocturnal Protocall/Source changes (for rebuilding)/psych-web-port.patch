+package backend.web;
+
+import openfl.utils.Assets;
+
+/** Web stand-in for sys.io.File, backed by the embedded asset library. */
+class WebFile
+{
+	static inline function clean(path:String):String
+	{
+		if (path == null) return null;
+		path = StringTools.replace(path, '\\', '/');
+		while (path.startsWith('./')) path = path.substr(2);
+		return path;
+	}
+
+	public static function getContent(path:String):String
+	{
+		path = clean(path);
+		return Assets.exists(path) ? Assets.getText(path) : null;
+	}
+
+	public static function getBytes(path:String):haxe.io.Bytes
+	{
+		path = clean(path);
+		return Assets.exists(path) ? Assets.getBytes(path) : null;
+	}
+
+	public static function saveContent(path:String, content:String):Void {}
+	public static function saveBytes(path:String, bytes:haxe.io.Bytes):Void {}
+	public static function copy(src:String, dst:String):Void {}
+}
diff --git a/source/backend/web/WebFileSystem.hx b/source/backend/web/WebFileSystem.hx
new file mode 100644
index 0000000..9d020f4
--- /dev/null
+++ b/source/backend/web/WebFileSystem.hx
@@ -0,0 +1,50 @@
+package backend.web;
+
+import openfl.utils.Assets;
+
+/** Web stand-in for sys.FileSystem, backed by the embedded asset library. */
+class WebFileSystem
+{
+	static function clean(path:String):String
+	{
+		if (path == null) return '';
+		path = StringTools.replace(path, '\\', '/');
+		while (path.startsWith('./')) path = path.substr(2);
+		while (path.endsWith('/')) path = path.substr(0, path.length - 1);
+		return path;
+	}
+
+	public static function exists(path:String):Bool
+	{
+		path = clean(path);
+		return Assets.exists(path) || isDirectory(path);
+	}
+
+	public static function isDirectory(path:String):Bool
+	{
+		path = clean(path) + '/';
+		for (id in Assets.list()) if (id.startsWith(path)) return true;
+		return false;
+	}
+
+	public static function readDirectory(path:String):Array<String>
+	{
+		path = clean(path) + '/';
+		var out:Array<String> = [];
+		for (id in Assets.list())
+		{
+			if (!id.startsWith(path)) continue;
+			var rest = id.substr(path.length);
+			var name = rest.split('/')[0];
+			if (name.length > 0 && !out.contains(name)) out.push(name);
+		}
+		return out;
+	}
+
+	public static function fullPath(path:String):String return path;
+	public static function absolutePath(path:String):String return path;
+	public static function createDirectory(path:String):Void {}
+	public static function deleteFile(path:String):Void {}
+	public static function deleteDirectory(path:String):Void {}
+	public static function rename(path:String, newPath:String):Void {}
+}
