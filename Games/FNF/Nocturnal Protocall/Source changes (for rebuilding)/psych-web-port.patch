+
+	// ---------------------------------------------------------------------
+	// onUpdate / onUpdatePost
+	// ---------------------------------------------------------------------
+	override function scriptUpdate(elapsed:Float)
+	{
+		// Forest.lua
+		var songPos = Conductor.songPosition / 1000;
+		if (songPos >= startTime && !appeared)
+		{
+			appeared = true;
+			growing = true;
+			tween('bfFadeIn', boyfriend, {alpha: 1}, 4, FlxEase.linear);
+		}
+
+		if (growing && boyfriend != null)
+		{
+			var currentX = boyfriend.scale.x;
+			if (currentX < maxScale)
+			{
+				var step = (maxScale - 2) / growTime;
+				var newScale = Math.min(currentX + step * elapsed, maxScale);
+				boyfriend.scale.set(newScale, newScale);
+			}
+		}
+
+		for (tag in ['tinkychase', 'tinkychase2'])
+		{
+			var c = spr(tag);
+			if (c == null || !c.visible) continue;
+			var first = tag == 'tinkychase';
+			var minS = first ? 0.6 : 0.4;
+			var maxS = first ? 2.4 : 1.85;
+			var base = first ? tinkyStartScale : 1.5;
+			var target = maxS - ((maxS - minS) * (ps.health / 2));
+			var cur = first ? tinkyScale : tinkyScale2;
+			cur = cur + (target - cur) * (elapsed * 5);
+			if (first) tinkyScale = cur; else tinkyScale2 = cur;
+
+			var cx = c.x + c.width / 2;
+			var cy = c.y + c.height / 2;
+			scaleObject(c, base * cur, base * cur);
+			c.x = cx - c.width / 2;
+			c.y = cy - c.height / 2;
+		}
+
+		if (custardGrowing)
+		{
+			var c = spr('custard');
+			if (c != null)
+			{
+				if (c.scale.x < custardMaxScale)
+				{
+					var step = (custardMaxScale - 0.1) / custardGrowTime;
+					var ns = Math.min(c.scale.x + step * elapsed, custardMaxScale);
+					c.scale.set(ns, ns);
+				}
+				else
+				{
+					custardGrowing = false;
+					tween('custardFall', c, {y: FlxG.height + 2000}, 1.3, FlxEase.cubeIn);
+				}
+			}
+		}
+
+		// CustardNote.lua
+		var fin = spr('guardianfinal');
+		if (fin != null && fin.animation.curAnim != null && fin.animation.curAnim.name == 'walk' && fin.animation.curAnim.finished)
+			removeSprite('guardianfinal');
+
+		// CamSwing.lua
+		if (camSwing)
+		{
+			swingTime += elapsed * swingSpeed;
+			camGame.angle = Math.sin(swingTime) * swingAmount;
+		}
+
+		// CharSwing.lua
+		if (charSwing)
+		{
+			swingProgress = Math.min(swingProgress + elapsed / swingDuration, 1);
+			var eased = Math.pow(swingProgress, 4);
+			var angle = swingStart + (swingTarget - swingStart) * eased;
+			boyfriend.angle = angle;
+			dad.angle = angle;
+			var f4 = spr('forest4');
+			if (f4 != null) f4.angle = angle;
+		}
+	}
+
+	override function scriptUpdatePost(elapsed:Float)
+	{
+		#if WEB_AUTOTEST
+		dbgT += elapsed;
+		if (dbgT > 1) { dbgT = 0;
+			trace('DBG pos=${Conductor.songPosition} hud.a=${camHUD.alpha} hud.vis=${camHUD.visible} game.a=${camGame.alpha} game.zoom=${camGame.zoom} scroll=${camGame.scroll} bf=${boyfriend.x},${boyfriend.y},a${boyfriend.alpha},s${boyfriend.scale.x} hb=${ps.healthBar.visible},${ps.healthBar.alpha} strum0=${ps.playerStrums.members[0].x},${ps.playerStrums.members[0].alpha},${ps.playerStrums.members[0].visible} cams=${FlxG.cameras.list.length} black=${spr('blackScreen').alpha} forest=${spr('forest') != null ? spr('forest').visible + ',' + spr('forest').x : 'null'} fx=${FlxG.camera.flashSprite.visible}');
+		}
+		#end
+		// icons.lua
+		ps.iconP1.x = 880;
+		ps.iconP2.x = 280;
+	}
+
+	// ---------------------------------------------------------------------
+	// onStepHit
+	// ---------------------------------------------------------------------
+	// Psych only fires stepHit once per frame, so on a slow frame a step can be
+	// skipped entirely. Replay every step we missed so no cue is ever lost.
+	var lastStepDone:Int = -1;
+	override function stepHit()
+	{
+		if (curStep <= lastStepDone) return;
+		for (s in (lastStepDone + 1)...(curStep + 1)) doStep(s);
+		lastStepDone = curStep;
+	}
+
+	function doStep(curStep:Int)
+	{
+		// Forest.lua
+		switch (curStep)
+		{
+			case 32:
+				removeSprite('text');
+
+			case 318:
+				growing = false;
+				boyfriend.scale.set(1, 1);
+				removeSprite('forest');
+
+			case 335:
+				var f = makeSprite('forest2', 'dayforest/forest2', 95, 280);
+				scaleObject(f, 2, 2);
+				addSprite('forest2', false);
+				ps.iconP2.alpha = 1;
+				dad.alpha = 1;
+
+			case 608:
+				removeSprite('forest2');
+				spr('tinkychase').visible = true;
+				dad.alpha = 0;
+				addScreenEffect();
+
+			case 736:
+				var f = makeSprite('forest3', 'dayforest/forest3', 95, 280);
+				scaleObject(f, 2, 2);
+				f.alpha = 0.2;
+				addSprite('forest3', false);
+				dad.alpha = 1;
+				spr('tinkychase').visible = false;
+				removeSprite('screeneffect');
+
+			case 864:
+				removeSprite('forest3');
+				var f = makeSprite('forest4', 'dayforest/forest4', 95, 280);
+				scaleObject(f, 2, 2);
+				f.alpha = 0.1;
+				addSprite('forest4', false);
+				boyfriend.alpha = 0;
+
+			case 896 | 960:
+				boyfriend.alpha = 1;
+				dad.alpha = 0;
+
+			case 928:
+				boyfriend.alpha = 0;
+				dad.alpha = 1;
+
+			case 992:
+				removeSprite('forest4');
+				ps.iconP2.alpha = 0;
+				var f = makeSprite('forest5', 'dayforest/forest5', 95, 280);
+				scaleObject(f, 2, 2);
+				f.alpha = 0.2;
+				addSprite('forest5', false);
+				spr('custard').visible = true;
+				custardGrowing = true;
+				boyfriend.alpha = 0;
+
+			case 1120:
+				ps.iconP2.alpha = 1;
+				removeSprite('forest5');
+				var c2 = spr('tinkychase2');
+				c2.visible = true;
+				c2.x = 100;
+				c2.y = 740;
+				scaleObject(c2, 1.5, 1.5);
+				boyfriend.alpha = 1;
+				addScreenEffect();
+
+			case 1248:
+				spr('tinkychase2').visible = false;
+				boyfriend.alpha = 0;
+				removeSprite('screeneffect');
+		}
+
+		// CustardNote.lua
+		if (curStep == 1248)
+		{
+			if (custardCount == 10)
+			{
+				var g = makeSprite('goodEnding', 'endings/goodEnding', 95, 280);
+				scaleObject(g, 2, 2);
+				addSprite('goodEnding', true);
+				addSprite('guardianfinal', true);
+				var fin:ModchartSprite = cast spr('guardianfinal');
+				if (fin != null)
+				{
+					fin.visible = true;
+					fin.playAnim('idle', true);
+				}
+				ps.iconP2.alpha = 0;
+			}
+			else
+			{
+				var b = makeSprite('badEnding', 'endings/badEnding', 95, 280);
+				scaleObject(b, 2, 2);
+				addSprite('badEnding', true);
+				ps.iconP1.alpha = 0;
+				ps.health = 0.01;
+			}
+		}
+		if (curStep == 1272 && custardCount == 10)
+		{
+			var fin:ModchartSprite = cast spr('guardianfinal');
+			if (fin != null) fin.playAnim('walk', true);
+		}
+	}
+
+	function addScreenEffect()
+	{
+		var s = makeSprite('screeneffect', 'screeneffect', 135, -20);
+		scaleObject(s, 0.67, 0.5);
+		setCamera(s, 'other');
+		addSprite('screeneffect', true);
+	}
+
+	// ---------------------------------------------------------------------
+	// onBeatHit
+	// ---------------------------------------------------------------------
+	override function beatHit()
+	{
+		// Forest.lua
+		for (tag in ['tinkychase', 'tinkychase2'])
+		{
+			var c:ModchartSprite = cast spr(tag);
+			if (c != null && c.visible && c.animation.curAnim != null && c.animation.curAnim.finished)
+				c.playAnim('idle', true);
+		}
+
+		// Screamers.lua
+		if (screamersOn)
+		{
+			var n = lastImage;
+			while (n == lastImage) n = FlxG.random.int(1, 5);
+			lastImage = n;
+			for (i in 1...6) spr('img$i').alpha = 0;
+			spr('img$n').alpha = 0.3;
+		}
+
+		// CharSwing.lua
+		if (charSwing)
+		{
+			swingStart = swingTarget;
+			swingTarget = -swingTarget;
+			swingProgress = 0;
+		}
+	}
+
+	// ---------------------------------------------------------------------
+	// Notes
+	// ---------------------------------------------------------------------
+	override function opponentNoteHit(note:Note)
+	{
+		// Forest.lua
+		for (tag in ['tinkychase', 'tinkychase2'])
+		{
+			var c:ModchartSprite = cast spr(tag);
+			if (c != null && c.visible)
+				c.playAnim(['left', 'down', 'up', 'right'][note.noteData], true);
+		}
+
+		// icons.lua
+		if (!note.isSustainNote && ps.health > 0.25)
+			ps.health -= 0.019;
+	}
+
+	override function goodNoteHit(note:Note)
+	{
+		// CustardNote.lua
+		if (note.noteType == 'CustardNote')
+		{
+			ps.health += 0.23;
+			custardCount++;
+			custardText.text = 'a player has collected $custardCount/10 custards';
+			custardText.alpha = 1;
+			cancelTimer('hideCustardText');
+			runTimer('hideCustardText', 2);
+		}
+	}
+
+	// ---------------------------------------------------------------------
+	// Events
+	// ---------------------------------------------------------------------
+	override function eventCalled(eventName:String, value1:String, value2:String, flValue1:Null<Float>, flValue2:Null<Float>, strumTime:Float)
+	{
+		#if WEB_AUTOTEST if (eventName != 'Add Camera Zoom') trace('EVENT $eventName $value1 $value2 at ${Conductor.songPosition} (strum $strumTime)'); #end
+		switch (eventName)
+		{
+			case 'CamSwing':
+				if (value1 == 'on') camSwing = true;
+				else
+				{
+					camSwing = false;
+					camGame.angle = 0;
+				}
+
+			case 'BlackScreen':
+				var speed:Float = Std.parseFloat(value2);
+				if (Math.isNaN(speed)) speed = 0;
+				var black = spr('blackScreen');
+				// A new BlackScreen command always overrides any fade still running
+				// (on slow frames an old fade could otherwise finish late and win).
+				for (t in ['blackFadeIn', 'blackFadeOut'])
+				{
+					var tw = tweens.get(t);
+					if (tw != null) { tw.cancel(); tweens.remove(t); }
+				}
+				if (value1 == 'on')
+				{
+					if (speed > 0) tween('blackFadeIn', black, {alpha: 1}, speed, FlxEase.linear);
+					else black.alpha = 1;
+				}
+				if (value1 == 'off' || value1 == '')
+				{
+					if (speed > 0) tween('blackFadeOut', black, {alpha: 0}, speed, FlxEase.linear);
+					else black.alpha = 0;
