diff --git a/source/funkin/backend/web/WebFS.hx b/source/funkin/backend/web/WebFS.hx
new file mode 100644
index 00000000..60756bd4
--- /dev/null
+++ b/source/funkin/backend/web/WebFS.hx
@@ -0,0 +1,61 @@
+package funkin.backend.web;
+
+import lime.utils.AssetLibrary;
+
+/**
+ * Web build: a read-only "file system" made from the game's preloaded asset manifest.
+ * Captured before Codename swaps in its own asset library tree, so lookups never recurse.
+ */
+class WebFS {
+	public static var raw(get, never):AssetLibrary;
+	static var _raw:AssetLibrary;
+	public static var files:Map<String, Bool>;
+	public static var dirs:Map<String, Array<String>>;
+
+	// The real (preloaded) library. Before Codename wraps it, it's "default";
+	// afterwards Codename keeps it as Paths.assetsTree.base.
+	static function get_raw():AssetLibrary {
+		var tree = funkin.backend.assets.Paths.assetsTree;
+		if (tree != null && tree.base != null) return tree.base;
+		return lime.utils.Assets.getLibrary("default");
+	}
+
+	public static function init() {
+		var r = raw;
+		if (r == _raw && files != null) return;
+		_raw = r;
+		files = [];
+		dirs = [];
+		if (r == null) return;
+		for (id in r.list(null)) {
+			files.set(id, true);
+			var parts = id.split("/");
+			var dir = "";
+			for (i in 0...parts.length) {
+				var list = dirs.get(dir);
+				if (list == null) dirs.set(dir, list = []);
+				if (!list.contains(parts[i])) list.push(parts[i]);
+				dir = dir == "" ? parts[i] : dir + "/" + parts[i];
+			}
+		}
+	}
+
+	public static function clean(path:String):String {
+		if (path == null) return "";
+		path = StringTools.replace(path, "\\", "/");
+		while (StringTools.startsWith(path, "./")) path = path.substr(2);
+		while (path.indexOf("//") >= 0) path = StringTools.replace(path, "//", "/");
+		while (StringTools.endsWith(path, "/")) path = path.substr(0, path.length - 1);
+		// resolve "a/b/../c"
+		var out:Array<String> = [];
+		for (p in path.split("/")) {
+			if (p == "..") { if (out.length > 0) out.pop(); }
+			else if (p != ".") out.push(p);
+		}
+		return out.join("/");
+	}
+
+	public static inline function isFile(path:String):Bool { init(); return files.exists(clean(path)); }
+	public static inline function isDir(path:String):Bool { init(); return dirs.exists(clean(path)); }
+	public static function list(path:String):Array<String> { init(); var l = dirs.get(clean(path)); return l == null ? [] : l.copy(); }
+}
