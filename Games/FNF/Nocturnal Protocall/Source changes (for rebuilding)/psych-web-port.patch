+		for (p in ['pop-ups/tinky', 'pop-ups/dipsy', 'pop-ups/lala', 'pop-ups/po', 'tinky', 'dayforest/text',
+			'dayforest/forest2', 'dayforest/forest3', 'dayforest/forest4', 'dayforest/forest5', 'screeneffect',
+			'endings/goodEnding', 'endings/badEnding'])
