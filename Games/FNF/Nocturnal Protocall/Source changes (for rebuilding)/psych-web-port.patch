+
+	// ---------------------------------------------------------------------
+	// onCreate — stage + global scripts (called where Psych runs stage Lua)
+	// ---------------------------------------------------------------------
+	override function scriptCreate()
+	{
+		// letterbox.lua
+		var barWidth = 160;
+		var l = makeSprite('leftBar', '', 0, 0);
+		l.makeGraphic(barWidth, FlxG.height, FlxColor.BLACK);
+		setCamera(l, 'other');
+		addSprite('leftBar', true);
+		var r = makeSprite('rightBar', '', FlxG.width - barWidth, 0);
+		r.makeGraphic(barWidth, FlxG.height, FlxColor.BLACK);
+		setCamera(r, 'other');
+		addSprite('rightBar', true);
+
+		// Forest.lua
+		var forest = makeSprite('forest', 'dayforest/forest', 44, 280);
+		forest.scrollFactor.set(1, 1);
+		scaleObject(forest, 2, 2);
+		addSprite('forest', false);
+
+		var chase = makeAnimatedSprite('tinkychase', 'characters/tinkyrun', tinkyX, tinkyY);
+		for (a in ['idle', 'left', 'down', 'up', 'right']) addAnimByPrefix(chase, a, a, 24, false);
+		scaleObject(chase, tinkyStartScale, tinkyStartScale);
+		addSprite('tinkychase', false);
+		chase.visible = false;
+		chase.playAnim('idle', true);
+
+		var chase2 = makeAnimatedSprite('tinkychase2', 'characters/tinkyrun', 350, 800);
+		for (a in ['idle', 'left', 'down', 'up', 'right']) addAnimByPrefix(chase2, a, a, 24, false);
+		scaleObject(chase2, 1.5, 1.5);
+		addSprite('tinkychase2', false);
+		chase2.visible = false;
+		chase2.playAnim('idle', true);
+
+		var custard = makeSprite('custard', 'dayforest/custard', custardX, custardY);
+		custard.scrollFactor.set(1, 1);
+		scaleObject(custard, custardScale, custardScale);
+		custard.visible = false;
+		addSprite('custard', false);
